{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agro-zia-com",
  "main": "_worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/multilingual-preview", "/multilingual-preview.html"]
  },
  "d1_databases": [
    {
      "binding": "AGROZIA_DB",
      "database_name": "agrozia-db11",
      "database_id": "e81f6625-99f4-4d52-a5a4-780cd82f4977"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AGROZIA_ATTACHMENTS",
      "bucket_name": "agrozia-attachments"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
