{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agro-zia-com",
  "main": "_worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "AGROZIA_DB",
      "database_name": "agrozia-db11",
      "database_id": "e81f6625-99f4-4d52-a5a4-780cd82f4977"
    }
  ]
}
