{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agrozia-store",
  "main": "_worker.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "STORE_DB",
      "database_name": "agrozia-store-db",
      "database_id": "REPLACE_WITH_NEW_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORE_ATTACHMENTS",
      "bucket_name": "agrozia-store-attachments"
    }
  ]
}
